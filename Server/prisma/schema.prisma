generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["views"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model alianca {
  id                                  Int            @id @default(autoincrement())
  color                               alianca_color?
  time1                               Int
  time2                               Int
  time3                               Int
  teleop_pontos                       Int
  auto_pontos                         Int
  faltas_pontos                       Int
  total_pontos                        Int
  total_rp                            Int
  partida_id                          Int?
  idade_media                         Int
  pre_historico                       Int
  estacionar                          Int
  sair                                Int
  partida_alianca_partida_idTopartida partida?       @relation("alianca_partida_idTopartida", fields: [partida_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "partida_id")
  equipe_alianca_time1Toequipe        equipe         @relation("alianca_time1Toequipe", fields: [time1], references: [numero_equipe], onDelete: NoAction, onUpdate: NoAction, map: "time1")
  equipe_alianca_time2Toequipe        equipe         @relation("alianca_time2Toequipe", fields: [time2], references: [numero_equipe], onDelete: NoAction, onUpdate: NoAction, map: "time2")
  equipe_alianca_time3Toequipe        equipe         @relation("alianca_time3Toequipe", fields: [time3], references: [numero_equipe], onDelete: NoAction, onUpdate: NoAction, map: "time3")

  @@index([time1], map: "time1_idx")
  @@index([time2], map: "time2_idx")
  @@index([partida_id], map: "partida_id_idx")
  @@index([time3], map: "time3_idx")
}

model equipe {
  numero_equipe                 Int       @id
  nome                          String    @db.VarChar(100)
  pontos_ranking                Int
  media_pontos                  Float
  alianca_alianca_time1Toequipe alianca[] @relation("alianca_time1Toequipe")
  alianca_alianca_time2Toequipe alianca[] @relation("alianca_time2Toequipe")
  alianca_alianca_time3Toequipe alianca[] @relation("alianca_time3Toequipe")
}

model partida {
  id                                  Int                  @id @default(autoincrement())
  numero_partida                      Int
  tipo_partida                        partida_tipo_partida
  azul_pontos                         Int
  vermelho_pontos                     Int
  status                              partida_status
  vencedor                            partida_vencedor
  horario                             String?              @db.VarChar(14)
  alianca_alianca_partida_idTopartida alianca[]            @relation("alianca_partida_idTopartida")
}

view ranking_view {
  numero_equipe    Int
  nome             String   @db.VarChar(100)
  total_rp         Decimal? @db.Decimal(32, 0)
  partidas_jogadas BigInt   @default(0)
  ranking_score    Decimal? @db.Decimal(35, 2)
  match_score      Decimal? @db.Decimal(13, 2)
  vitorias         Decimal? @db.Decimal(23, 0)
  derrotas         Decimal? @db.Decimal(23, 0)
  empates          Decimal? @db.Decimal(23, 0)
}

enum partida_status {
  agendada
  em_progresso
  completada
}

enum alianca_color {
  azul
  vermelho
}

enum partida_vencedor {
  azul
  vermelho
  empate
  no
}

enum partida_tipo_partida {
  qualificatorias
  eliminatorias
  treino
}
